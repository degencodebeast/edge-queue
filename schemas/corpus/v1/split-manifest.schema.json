{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edgequeue.local/schemas/corpus/v1/split-manifest.schema.json",
  "title": "Split Manifest", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "split", "case_digests", "manifest_digest"],
  "properties": {"schema_version": {"const": "1.0"}, "split": {"enum": ["DEV", "AH", "PCH"]}, "case_digests": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["case_id", "ranker_digest", "scorer_digest"], "properties": {"case_id": {"type": "string", "pattern": "^EQ-F(?:0[1-9]|10)-(?:DEV|AH|PCH)-[0-9]{2}$"}, "ranker_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "scorer_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}, "manifest_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
