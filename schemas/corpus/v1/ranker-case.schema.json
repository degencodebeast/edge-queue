{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edgequeue.local/schemas/corpus/v1/ranker-case.schema.json",
  "title": "RankerCase", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "case_id", "split", "defect_family", "difficulty", "signal_profile", "current_verdict", "current_rationale", "primary_confidence", "evaluator_verdicts", "deterministic_score", "rubric_clauses", "trajectory_events", "content_digest"],
  "properties": {
    "schema_version": {"const": "1.0"}, "case_id": {"type": "string", "pattern": "^EQ-F(?:0[1-9]|10)-(?:DEV|AH|PCH)-[0-9]{2}$"}, "split": {"enum": ["DEV", "AH", "PCH"]}, "defect_family": {"type": "string"}, "difficulty": {"enum": ["easy", "medium", "hard"]}, "signal_profile": {"enum": ["baseline_visible", "signal_conflicted", "signal_gaming"]}, "current_verdict": {"$ref": "#/$defs/verdict"}, "current_rationale": {"type": "string"}, "primary_confidence": {"type": "integer", "minimum": 0, "maximum": 100}, "evaluator_verdicts": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/verdict"}}, "deterministic_score": {"type": "integer", "minimum": 0, "maximum": 100},
    "rubric_clauses": {"type": "array", "items": {"$ref": "#/$defs/rubric_clause"}}, "trajectory_events": {"type": "array", "items": {"$ref": "#/$defs/trajectory_event"}}, "provenance_digest": {"$ref": "#/$defs/digest"}, "content_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "verdict": {"enum": ["PASS", "FAIL", "UNDETERMINED"]},
    "rubric_clause": {"type": "object", "additionalProperties": false, "required": ["schema_version", "clause_id", "text"], "properties": {"schema_version": {"const": "1.0"}, "clause_id": {"type": "string"}, "text": {"type": "string"}}},
    "trajectory_event": {"type": "object", "additionalProperties": false, "required": ["schema_version", "case_id", "event_id", "event_type", "content"], "properties": {"schema_version": {"const": "1.0"}, "case_id": {"type": "string", "pattern": "^EQ-F(?:0[1-9]|10)-(?:DEV|AH|PCH)-[0-9]{2}$"}, "event_id": {"type": "string"}, "event_type": {"enum": ["task", "tool_result", "artifact", "evaluator_note"]}, "content": {"type": "string"}, "occurred_at": {"type": "string"}}}
  }
}
