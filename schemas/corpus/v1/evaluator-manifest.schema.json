{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edgequeue.local/schemas/corpus/v1/evaluator-manifest.schema.json",
  "title": "Evaluator Manifest", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "rubric_version", "evaluators", "retry_policy"],
  "properties": {"schema_version": {"const": "1.0"}, "manifest_id": {"type": "string"}, "rubric_version": {"type": "string"}, "evaluators": {"type": "array", "items": {"type": "string"}}, "retry_policy": {"type": "string"}, "content_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
