{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edgequeue.local/schemas/corpus/v1/frozen-initial-evaluation.schema.json",
  "title": "Frozen Initial Evaluation", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "case_id", "verdict", "rationale", "confidence", "evaluator_manifest_digest"],
  "properties": {"schema_version": {"const": "1.0"}, "case_id": {"type": "string", "pattern": "^EQ-F(?:0[1-9]|10)-(?:DEV|AH|PCH)-[0-9]{2}$"}, "verdict": {"enum": ["PASS", "FAIL", "UNDETERMINED"]}, "rationale": {"type": "string"}, "confidence": {"type": "integer", "minimum": 0, "maximum": 100}, "evaluator_manifest_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "content_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
