{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edgequeue.local/schemas/corpus/v1/scorer-case.schema.json",
  "title": "ScorerCase", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "case_id", "reference_verdict", "kind", "decisive_event_ids", "scorer_sentinel", "content_digest"],
  "properties": {"schema_version": {"const": "1.0"}, "case_id": {"type": "string", "pattern": "^EQ-F(?:0[1-9]|10)-(?:DEV|AH|PCH)-[0-9]{2}$"}, "reference_verdict": {"enum": ["PASS", "FAIL", "UNDETERMINED"]}, "kind": {"type": "string"}, "decisive_event_ids": {"type": "array", "items": {"type": "string"}}, "scorer_sentinel": {"type": "string"}, "content_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
