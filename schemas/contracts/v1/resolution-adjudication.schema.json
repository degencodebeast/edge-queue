{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edgequeue.local/schemas/contracts/v1/resolution-adjudication.schema.json",
  "title": "Resolution Adjudication", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "adjudication_id", "case_id", "conflict_adjudication_digests", "action", "resulting_verdict", "rationale", "reviewer_id", "reviewer_role", "reviewer_manifest_version", "reviewer_manifest_digest", "prior_record_digest"],
  "properties": {"schema_version": {"const": "1.0"}, "adjudication_id": {"type": "string"}, "case_id": {"type": "string"}, "conflict_adjudication_digests": {"type": "array", "minItems": 2, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "action": {"enum": ["preserve", "correct", "abstain"]}, "resulting_verdict": {"enum": ["PASS", "FAIL", "UNDETERMINED"]}, "rationale": {"type": "string"}, "reviewer_id": {"type": "string"}, "reviewer_role": {"enum": ["reviewer", "conflict_resolver", "calibration_promoter"]}, "reviewer_manifest_version": {"type": "string"}, "reviewer_manifest_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "prior_record_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
