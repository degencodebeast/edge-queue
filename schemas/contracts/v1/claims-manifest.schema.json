{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edgequeue.local/schemas/contracts/v1/claims-manifest.schema.json",
  "title": "Claims Manifest", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "evaluation_run_digest", "claims", "content_digest"],
  "properties": {"schema_version": {"const": "1.0"}, "evaluation_run_digest": {"$ref": "#/$defs/digest"}, "claims": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/digest"}}, "content_digest": {"$ref": "#/$defs/digest"}},
  "$defs": {"digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
